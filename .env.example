VITE_API_BASE_URL=http://localhost:8000/api

# The full URL of your backend's Google OAuth redirect endpoint
# This is what the "Continue with Google" button points to
VITE_GOOGLE_AUTH_URL=http://localhost:8000/api/auth/google/redirect

# The full URL of your backend's LinkedIn OAuth redirect endpoint
# This is what the "Continue with LinkedIn" button points to
VITE_LINKEDIN_AUTH_URL=http://localhost:8000/api/auth/linkedin/redirect

# The full URL of your backend's GitHub OAuth redirect endpoint
# This is what the "Continue with GitHub" button points to
VITE_GITHUB_AUTH_URL=http://localhost:8000/api/auth/github/redirect

# Frontend URL — must match FRONTEND_URL in the backend .env
VITE_APP_URL=http://localhost:5173